{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Register the cloudflare:test ambient module declarations (env, applyD1Migrations,
    // D1Migration) used by the workerd test suite. `types` does NOT merge across
    // `extends`, so re-list @cloudflare/workers-types (for D1Database in src) too.
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
