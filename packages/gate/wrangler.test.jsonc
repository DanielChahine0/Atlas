{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Test-only wrangler config for @cloudflare/vitest-pool-workers. Uses local-only D1
  // so the pool stays fully local. The CI one-writer gate scans apps/*/wrangler.jsonc
  // only (NOT wrangler.test.jsonc), so this mirror does not affect the consumer count.
  "name": "gate-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["nodejs_compat"],
  "queues": {
    "producers": [
      { "binding": "INCIDENTS", "queue": "atlas-incidents" }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atlas-db",
      "migrations_dir": "../../migrations"
    }
  ]
}
