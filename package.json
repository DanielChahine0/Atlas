{
  "name": "atlas",
  "version": "0.0.0",
  "private": true,
  "description": "Atlas — personal multi-agent orchestrator on Cloudflare (the spine + 16 sub-agents).",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm run test:registry",
    "test:registry": "node --test test/mcp-registry.test.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.13",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.98.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@cloudflare/workers-oauth-provider": "^0.7.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "agents": "^0.14.1",
    "jose": "^6.2.3",
    "zod": "^3.25 || ^4.0"
  }
}
