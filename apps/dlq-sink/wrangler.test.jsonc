{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Test-only wrangler config for @cloudflare/vitest-pool-workers. Mirrors the
  // production apps/dlq-sink/wrangler.jsonc but uses local-only D1/KV (no remote IDs)
  // so the pool stays fully local. The CI one-writer gate scans apps/*/wrangler.jsonc
  // only (NOT wrangler.test.jsonc), so this mirror does not affect the consumer count.
  "name": "dlq-sink-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["nodejs_compat"],
  // Consumes BOTH dead-letter queues (atlas-wire-dlq + atlas-incidents-dlq) and produces
  // onto the live bus (atlas-wire + atlas-incidents). NOT an atlas-wire consumer — Pillar 1 holds.
  "queues": {
    "producers": [
      { "binding": "WIRE", "queue": "atlas-wire" },
      { "binding": "INCIDENTS", "queue": "atlas-incidents" }
    ],
    "consumers": [
      {
        "queue": "atlas-wire-dlq",
        "max_concurrency": 1,
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      },
      {
        "queue": "atlas-incidents-dlq",
        "max_concurrency": 1,
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 0
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atlas-db",
      "migrations_dir": "../../migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "CONFIG", "id": "test-config" }]
}
