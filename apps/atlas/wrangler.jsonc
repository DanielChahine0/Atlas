{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atlas",
  "main": "src/index.ts",
  // D-09: >= 2026-04-07 enables web_socket_auto_reply_to_close (Echo, later).
  "compatibility_date": "2026-04-25",
  // REQUIRED by the `agents` SDK — omitting it is a runtime failure.
  "compatibility_flags": ["nodejs_compat"],

  // Atlas's AtlasCoordinator DO, addressed as env.ATLAS.getByName("root").
  // The DO + heartbeat land in Wave 2 (Plan 02). The Phase-1 morning chain is
  // driven by the separate MORNING_CHAIN Workflow binding (below), NOT a DO.
  "durable_objects": {
    "bindings": [
      { "name": "ATLAS", "class_name": "AtlasCoordinator" }
    ]
  },
  // SQLite-backed DOs (Free-tier eligible) — NEVER legacy `new_classes`.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AtlasCoordinator"] }],

  // Atlas is a Wire PRODUCER only (Pillar 1). It declares no read side on the
  // bus; the lone reader is Steward, in apps/steward.
  "queues": {
    "producers": [{ "binding": "WIRE", "queue": "atlas-wire" }]
  },

  // D1 system-of-record (atlas-db). All counters + idempotency keys live here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atlas-db",
      "database_id": "e7fee76c-2e3d-486e-8a8a-fd1aec6a5af3",
      // Shared repo-root migrations/ dir (one D1 across all Workers), resolved
      // relative to this wrangler.jsonc.
      "migrations_dir": "../../migrations"
    }
  ],

  // CONFIG = model-tier overrides / flags / label->color map (never secrets,
  // never counters). OAUTH_KV = grants/tokens for the inbound OAuthProvider
  // (must be a REAL KV namespace or the provider fails at startup).
  "kv_namespaces": [
    { "binding": "CONFIG", "id": "296ee0ec788542c68bb01a90e46c6cf2" },
    { "binding": "OAUTH_KV", "id": "970e569e796a4868ad82449885d0319f" }
  ],

  // R2 blob store (atlas-blobs). audio/raw/ expires 7d; transcripts/exports persist.
  // NOTE: the bucket is provisioned once R2 is enabled on the account (see the
  // Plan 00-01 SUMMARY checkpoint). The binding is declared here and ready.
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "atlas-blobs" }],

  // Workers AI binding — all Claude routes through claudeFor(agent,env) -> AI Gateway.
  "ai": { "binding": "AI" },

  // The no-op agent service-binding (D-11), added in Wave 3 (Plan 00-03, Task 4) —
  // the W3 leg of the GLOBAL-4 cross-wave handoff: 00-01 wrote the base config in W1,
  // THIS plan adds the services NOOP binding in W3, and 00-06 adds secrets_store_secrets
  // in W4. Strictly increasing waves keep this shared file race-free, and the NOOP binding
  // lands in the SAME wave as the env.NOOP.tick() dispatcher code that uses it.
  //
  // SELF-binding: `service: "atlas"` points the Worker at itself, so the scheduled()
  // dispatcher's `env.NOOP.tick(...)` resolves to the same-Worker NoopAgent WorkerEntrypoint
  // over a PRIVATE Worker-to-Worker RPC (no public HTTP surface — T-00-31). NoopAgent is
  // exported from src/index.ts. Atlas remains a Wire producer only (no consumer side).
  "services": [
    { "binding": "NOOP", "service": "atlas", "entrypoint": "NoopAgent" },
    // Phase 1 (D-11): the five morning-chain agent service bindings. Each points at the
    // agent's Worker (its WorkerEntrypoint default export), so a MorningChain step's
    // invokeAgent(env, "filer", …) resolves to env.FILER.sweep(…) over a PRIVATE
    // Worker-to-Worker RPC (no public HTTP). Atlas stays a Wire producer only.
    { "binding": "FILER", "service": "filer" },
    { "binding": "HERALD", "service": "herald" },
    { "binding": "FORGE", "service": "forge" },
    { "binding": "SUNDIAL", "service": "sundial" },
    { "binding": "COMPASS", "service": "compass" }
  ],

  // Phase 1 (CORE-01): the MorningChain Workflow binding. ONE 07:45 cron creates a
  // single instance (id morning-<date>) that runs the five agents as start-after-success
  // steps — NOT five racing crons. MorningChain is exported from src/index.ts.
  "workflows": [
    {
      "name": "atlas-morning-chain",
      "binding": "MORNING_CHAIN",
      "class_name": "MorningChain"
    }
  ],

  // The ONE morning-chain cron (CORE-01). Cron Triggers are UTC-only / no DST (D1):
  // 07:45 ET = "45 11 * * 1-5" (EDT) / "45 12 * * 1-5" (EST). Weekdays only (Mon-Fri).
  // Hand-edit at each DST boundary (CLAUDE.md /cron-utc). This is the ONLY cron that
  // kicks the Workflow; the per-stage 08:00/08:15/08:20/08:30 times are step.sleepUntil
  // budget gates INSIDE the Workflow, never separate crons.
  "triggers": { "crons": ["45 11 * * 1-5"] },

  // The three OAuth provider secrets the SPINE-04 code reads via `await env.X.get()`
  // (oauth/google.ts + oauth/github.ts) — bound from the single per-account Cloudflare
  // Secrets Store. This is the W4 leg of the GLOBAL-4 cross-wave handoff: 00-01 wrote the
  // base config in W1, 00-03 added the `services` NOOP binding in W3, and THIS plan (00-06)
  // adds `secrets_store_secrets` in W4. Strictly increasing waves keep this shared file
  // race-free, and the binding lands in the SAME wave as the code that reads it.
  //
  // NEVER a secret VALUE here — only a TYPE/binding reference (binding name + store id +
  // the seeded secret name). The `store_id` is a placeholder until the owner creates the
  // store (Plan 00-06 Task-6 gate: `wrangler secrets-store store create atlas --remote`
  // prints the real `<atlas-store-id>`; fill it in then). Reads are async: `await env.X.get()`.
  // `--remote` secrets aren't readable in `wrangler dev` — make non-remote dev copies.
  "secrets_store_secrets": [
    {
      "binding": "GOOGLE_CLIENT_SECRET",
      "store_id": "<atlas-store-id>",
      "secret_name": "google-oauth-client-secret"
    },
    {
      "binding": "GOOGLE_REFRESH_TOKEN",
      "store_id": "<atlas-store-id>",
      "secret_name": "google-refresh-token"
    },
    {
      "binding": "GH_APP_PRIVATE_KEY",
      "store_id": "<atlas-store-id>",
      "secret_name": "github-app-private-key"
    },
    // Post-review hardening (the OAuth front door owner-session gate). OWNER_AUTH_TOKEN gates the
    // /authorize consent surface (/login constant-time-compares against it); SESSION_SIGNING_KEY
    // signs the session cookie (optional — if omitted the key is HKDF-derived from
    // OWNER_AUTH_TOKEN). Declared-and-deferred like the three above: seeded at the owner Gate C.
    {
      "binding": "OWNER_AUTH_TOKEN",
      "store_id": "<atlas-store-id>",
      "secret_name": "owner-auth-token"
    },
    {
      "binding": "SESSION_SIGNING_KEY",
      "store_id": "<atlas-store-id>",
      "secret_name": "session-signing-key"
    }
  ],

  // PLAINTEXT non-secrets ONLY. NEVER secrets, NEVER counters. Real credentials
  // are bound separately via Secrets Store / `wrangler secret put` in Plan 06/07.
  "vars": {
    "AIG_ACCOUNT_ID": "<set-before-phase-1>",
    "AIG_GATEWAY_ID": "atlas-reasoning",
    "MODEL_ATLAS": "claude-opus-4-8",
    "MODEL_DEFAULT": "claude-sonnet-4-6",
    // OAuth NON-secret identifiers (SPINE-04). The Google client id + redirect URI and the
    // GitHub App client id (the JWT `iss`) are PUBLIC identifiers, not secrets — they belong
    // in [vars]. Seeded by the owner gates (Plan 00-06 Tasks 4-5). The client SECRET / refresh
    // token / private KEY are in secrets_store_secrets above, NEVER here.
    "GOOGLE_CLIENT_ID": "<set-after-gcp-oauth-client>",
    "GOOGLE_REDIRECT_URI": "<deployed-atlas-authorize-callback>",
    "GH_APP_CLIENT_ID": "<set-after-github-app>",
    // Round-2 hardening: the out-of-band OAuth client registry (NON-secret) — a JSON array of
    // { clientId, redirectUris, clientName } seeded into OAUTH_KV at startup (auth/clients.ts).
    // The provider exposes NO anonymous registration endpoint, so an attacker can't self-register
    // a confidential client with their own redirect_uri. Declared-and-deferred: the owner fills
    // this with the daemon + each MCP client's id + redirect URIs at Gate C. Empty = seeding no-op.
    "CLIENT_REGISTRY": "[]"
  },

  "observability": { "enabled": true },

  "env": {
    // Staging fires NO crons (CLAUDE.md). Cron lines themselves first appear in
    // Phase 1 (one cron kicks the MorningChain Workflow — never 5 stage crons).
    "staging": {
      "triggers": { "crons": [] }
    }
  }
}
