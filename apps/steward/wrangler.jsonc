{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "steward",
  "main": "src/index.ts",
  // D-09: match Atlas — >= 2026-04-07 floor; pair with nodejs_compat (Agents SDK).
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["nodejs_compat"],

  // The single Vault write lock: env.STEWARD_LOCK.getByName("vault").
  // One name = one instance = the sole serialized writer (Pillar 1). The
  // StewardWriter critical section (atomic dedup + counter bump) lands in
  // Wave 2 (Plan 04) together with the bus reader.
  "durable_objects": {
    "bindings": [{ "name": "STEWARD_LOCK", "class_name": "StewardWriter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StewardWriter"] }],

  // Steward PRODUCES on the Wire (it emits Flagger incidents) AND is the SOLE
  // CONSUMER of atlas-wire — the lone reader of the bus (Pillar 1). apps/steward
  // is the ONLY Worker in the repo with a queues.consumers block on atlas-wire; a
  // second consumer anywhere is a hard CI failure.
  //
  // Serialization is double-enforced: max_concurrency:1 (the belt) + the single
  // named DO lock getByName("vault") (the suspenders). dead_letter_queue routes
  // exhausted-retry messages to atlas-wire-dlq so they never drop silently
  // (SPINE-05). NOTE: the stale per-consumer retry-delay key (RESEARCH Pitfall 6)
  // is intentionally omitted — it is not a valid consumer-level config key; the
  // per-message retry delay is set in code via msg.retry({delaySeconds:60}).
  "queues": {
    "producers": [
      { "binding": "WIRE", "queue": "atlas-wire" },
      { "binding": "INCIDENTS", "queue": "atlas-incidents" }
    ],
    "consumers": [
      {
        "queue": "atlas-wire",
        "max_concurrency": 1,
        "max_batch_size": 10,
        "max_batch_timeout": 10,
        "max_retries": 5,
        "dead_letter_queue": "atlas-wire-dlq"
      }
    ]
  },

  // D1 system-of-record — Steward owns the atomic counter/idempotency writes.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atlas-db",
      "database_id": "e7fee76c-2e3d-486e-8a8a-fd1aec6a5af3",
      "migrations_dir": "../../migrations"
    }
  ],

  // Read-mostly config/flags (label->color map, model tiers). Never secrets/counters.
  "kv_namespaces": [
    { "binding": "CONFIG", "id": "296ee0ec788542c68bb01a90e46c6cf2" }
  ],

  // Phase 3 (03-03): cross-script Workflows binding for the Archivist Worker.
  // Steward triggers ArchivistWorkflow instances on transcript.ready events via:
  //   env.ARCHIVIST_WF.create({ id: `archivist-${session_id}`, params: { session_id } })
  // All four keys are required for a cross-script binding (Wrangler v4 WorkflowBinding):
  //   - binding: the env field name
  //   - name: the Workflow name (matches apps/archivist/wrangler.jsonc "name")
  //   - class_name: the exported Workflow class (matches ArchivistWorkflow in archivist.ts)
  //   - script_name: the Worker script name that exports ArchivistWorkflow ("archivist")
  // This is NOT a second atlas-wire consumer — the binding is a private cross-script
  // Workflow trigger, not a queue consumer (Pillar 1 preserved; T-03-03-06 mitigated).
  "workflows": [
    {
      "binding": "ARCHIVIST_WF",
      "name": "atlas-archivist",
      "class_name": "ArchivistWorkflow",
      "script_name": "archivist"
    }
  ],

  "observability": { "enabled": true },

  "env": {
    // Staging fires NO crons.
    "staging": {
      "triggers": { "crons": [] }
    }
  }
}
