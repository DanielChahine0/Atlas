{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "echo-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["nodejs_compat"],

  // EchoSession DO — required for test env (same class as prod).
  "durable_objects": {
    "bindings": [{ "name": "ECHO_SESSION", "class_name": "EchoSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EchoSession"] }],

  // Wire + Incidents producers — test stubs (no real queues in workerd test pool).
  "queues": {
    "producers": [
      { "binding": "WIRE", "queue": "atlas-wire" },
      { "binding": "INCIDENTS", "queue": "atlas-incidents" }
    ]
  },

  // D1 — no database_id in test config (test pool uses an in-memory D1).
  "d1_databases": [
    { "binding": "DB", "database_name": "atlas-db", "migrations_dir": "../../migrations" }
  ],

  // CONFIG KV — stub id for test environment.
  "kv_namespaces": [{ "binding": "CONFIG", "id": "test-config" }]
}
