{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "headhunter-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["nodejs_compat"],
  "queues": {
    "producers": [
      { "binding": "WIRE", "queue": "atlas-wire" },
      { "binding": "INCIDENTS", "queue": "atlas-incidents" }
    ]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "atlas-db", "migrations_dir": "../../migrations" }
  ],
  "kv_namespaces": [{ "binding": "CONFIG", "id": "test-config" }],
  "durable_objects": {
    "bindings": [{ "name": "HEADHUNTER_STATE", "class_name": "HeadhunterState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HeadhunterState"] }]
}
