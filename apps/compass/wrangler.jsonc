{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "compass",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["nodejs_compat"],

  // CompassState — the per-run state DO. new_sqlite_classes.
  "durable_objects": {
    "bindings": [{ "name": "COMPASS_STATE", "class_name": "CompassState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CompassState"] }],

  // Pillar 1: Compass is a Wire PRODUCER only — it emits compass:plan:<date>. NO consumers.
  // D2-05: Compass also produces onto atlas-incidents via flag() for overcommit incidents.
  "queues": {
    "producers": [
      { "binding": "WIRE", "queue": "atlas-wire" },
      { "binding": "INCIDENTS", "queue": "atlas-incidents" }
    ]
  },

  // D1 — Compass READS open tasks (readOpenTasks) via @atlas/tasks.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atlas-db",
      "migrations_dir": "../../migrations"
    }
  ],

  // Read-mostly config/flags — INCLUDING compass.effort (D1-05: Opus effort=medium default,
  // KV-overridable, never high). meeting_buffer_min / min_block_min are also CONFIG-tunable.
  "kv_namespaces": [{ "binding": "CONFIG", "id": "296ee0ec788542c68bb01a90e46c6cf2" }],

  // Workers AI gateway routing — Compass plan synthesis resolves to Opus via claudeFor.
  "ai": { "binding": "AI" },

  // The independent 21:00 EDT preview cron (a next-day glance, separate from the morning
  // chain's compass-plan step). Cron Triggers are UTC-only / no DST (D1): 21:00 EDT =
  // "0 1 * * *"; 21:00 EST = "0 2 * * *". Hand-edit at the DST boundary.
  "triggers": { "crons": ["0 1 * * *"] },

  "observability": { "enabled": true },

  "env": {
    "staging": {
      "triggers": { "crons": [] }
    }
  }
}
