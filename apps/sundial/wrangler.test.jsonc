{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sundial-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "SUNDIAL_STATE", "class_name": "SundialState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SundialState"] }],
  "queues": {
    "producers": [
      { "binding": "WIRE", "queue": "atlas-wire" },
      { "binding": "INCIDENTS", "queue": "atlas-incidents" }
    ]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "atlas-db", "migrations_dir": "../../migrations" }
  ],
  "kv_namespaces": [{ "binding": "CONFIG", "id": "test-config" }],
  "vars": {
    "GATE_BASE_URL": "https://gate.test.invalid"
  }
}
