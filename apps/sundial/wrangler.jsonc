{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sundial",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["nodejs_compat"],

  // SundialState — the per-run state DO (run bookkeeping). new_sqlite_classes.
  "durable_objects": {
    "bindings": [{ "name": "SUNDIAL_STATE", "class_name": "SundialState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SundialState"] }],

  // Pillar 1: Sundial is a Wire PRODUCER only — it emits sundial-<date>. NO consumers block.
  // D2-05: Sundial also produces onto atlas-incidents via flag() for calendar sync incidents.
  "queues": {
    "producers": [
      { "binding": "WIRE", "queue": "atlas-wire" },
      { "binding": "INCIDENTS", "queue": "atlas-incidents" }
    ]
  },

  // D1 — Sundial READS the tasks store (readOpenDeadlineTasks) via @atlas/tasks.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atlas-db",
      "database_id": "e7fee76c-2e3d-486e-8a8a-fd1aec6a5af3",
      "migrations_dir": "../../migrations"
    }
  ],

  // Read-mostly config/flags. Never secrets.
  "kv_namespaces": [{ "binding": "CONFIG", "id": "296ee0ec788542c68bb01a90e46c6cf2" }],

  // No AI binding — the task→block mapping is DETERMINISTic (no model required).
  // Sundial has NO cron — it runs as the `sundial-sync` MorningChain step (08:20).

  // Vars — plaintext non-secrets only (never secrets here per CLAUDE.md).
  // GATE_BASE_URL: the confirm page base URL for openGate() confirm push links.
  "vars": {
    "GATE_BASE_URL": "https://gate.atlas.workers.dev"
  },

  // Secrets Store — NTFY_TOPIC/NTFY_TOKEN read via async get().
  // Required so openGate() can dispatch the owner confirm push (04-01).
  // NEVER in [vars], KV, Vault, Codex, audit_log, or any tracked file.
  // store_id placeholder: replace <atlas-store-id> with the real Cloudflare Secrets
  // Store ID after provisioning (same store as flagger/mcp-google/atlas).
  "secrets_store_secrets": [
    { "binding": "NTFY_TOPIC", "store_id": "<atlas-store-id>", "secret_name": "ntfy-topic" },
    { "binding": "NTFY_TOKEN", "store_id": "<atlas-store-id>", "secret_name": "ntfy-token" }
  ],

  "observability": { "enabled": true },

  "env": {
    "staging": {
      "triggers": { "crons": [] }
    }
  }
}
