{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "includeCoAuthoredBy": true,
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(npx wrangler:*)",
      "Bash(node:*)",
      "Bash(corepack:*)",
      "Bash(tsc:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(lsof:*)",
      "Bash(curl http://localhost:*)",
      "Bash(curl http://127.0.0.1:*)",
      "Bash(curl -k https://127.0.0.1:*)",
      "Read(./**)",
      "ToolSearch",
      "WebSearch",
      "mcp__context7__*",
      "mcp__cloudflare-docs__*",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:modelcontextprotocol.io)",
      "WebFetch(domain:npmjs.com)",
      "WebFetch(domain:github.com)"
    ],
    "ask": [
      "Bash(npx wrangler deploy:*)",
      "Bash(npx wrangler delete:*)",
      "Bash(npx wrangler secret:*)",
      "Bash(npx wrangler secrets-store:*)",
      "Bash(npx wrangler d1 execute:*)",
      "Bash(git push:*)",
      "mcp__github__*"
    ],
    "deny": [
      "Read(./.dev.vars)",
      "Read(./.dev.vars.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secrets.js\"",
            "timeout": 5000,
            "statusMessage": "Checking for secrets / canon edits..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-wire-consumer.js\"",
            "timeout": 5000,
            "statusMessage": "Checking one-writer (atlas-wire consumer) rule..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.js\"",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
